@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
# Optional deps — header-only via BUILD_INTERFACE only (re_* targets link
# glm/spdlog/json with $<BUILD_INTERFACE:...>), so the installed export does
# not hard-require them. Use plain find_package QUIET (not find_dependency)
# so missing system packages do not propagate REQUIRED from the parent
# find_package(RenderEngine REQUIRED) — the consumer fetches them via
# FetchContent in examples/CMakeLists.txt when needed.
find_package(glm QUIET)
find_package(glfw3 QUIET)
find_package(spdlog QUIET)
find_package(nlohmann_json QUIET)

include("${CMAKE_CURRENT_LIST_DIR}/RenderEngineTargets.cmake")

check_required_components(RenderEngine)
