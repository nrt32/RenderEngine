# comment_context waivers — ERE matched against <path> or <path>:<line>
# Added per spec-review #12: allow bare RE_GLSL_VERSION note in shader headers
# and T18 citation in test_utils (otherwise >=120 chars would be required there).
render/shaders/.*\.glsl
render/shaders/re_glsl_version\.hpp
test_utils/pixel_reader\..*
test_utils/offscreen_context\..*
test_utils/capture_helpers\..*
# Spec-review #13: examples/ is NOT in AUDIT_SOURCE_DIRS (consumer sample, not audited for comment prose)
examples/.*
core/caps\.hpp
core/caps\.cpp
tests/t11_volume_caps_test\.cpp
tests/t13_nrrd_preprobe_test\.cpp
tests/t5_volume_test\.cpp
