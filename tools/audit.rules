# =============================================================================
# PROJECT audit rules (tools/audit.rules) — RenderEngine
# It is DATA, not framework logic. The engine (tools/audit.sh) runs these plus
# built-in generic checks (branch on main, no warning-suppression flags/pragmas,
# state-file schema, no tracked binaries outside allowed dirs).
#
# Format: name<TAB>mode<TAB>target<TAB>message
# Modes:
#   forbid_grep    regex            fail if regex found in source dirs
#   require_grep   regex            fail if regex NOT found in source dirs
#   forbid_flag    token            fail if token appears in build files
#   forbid_pragma  token            fail if token appears in source files
#   forbid_ext     ext,csv          fail if tracked files carry these extensions
#   forbid_outside dir|regex        fail if regex matches any source OUTSIDE dir
#                                  (the FIRST '|' splits dir from regex, so the
#                                  regex may itself contain '|' alternations)
#   require_only   dir|regex        fail if regex matches outside dir AND has a match inside dir
# '#' lines are comments. Source-scanning rules scan ONLY the directories in
# AUDIT_SOURCE_DIRS (default: src include lib engine tests app). If your
# owning-module rule must cover dirs outside the defaults, override
# AUDIT_SOURCE_DIRS in env (or add those dirs) or the audit can't see them.
# Rules are skipped when no source dirs exist yet; build-file rules are skipped
# when no build files exist yet.
#
# NOTE: project layout uses io/ data/ volume/ core/ render/ app/ tests/, so
# AUDIT_SOURCE_DIRS must be overridden to include them (see audit.sh env or
# run_task.sh) for the ownership/forbidden rules below to take effect.
# =============================================================================

# --- Hard-coded secrets anywhere in the tree (generic, keep this one) ----------
no_secrets	forbid_grep	(api[_-]?key|password|secret)\s*=\s*["'][A-Za-z0-9+/]{12,}	hard-coded secrets are forbidden

# --- Dependency lock: every FetchContent_Declare must carry a pinned GIT_TAG ---
# (must be a release tag or commit SHA, never a branch name; the mechanical
# floor below rejects common branch names in every build file incl. the root
# CMakeLists.txt, reviewer verifies the rest)
deps_pinned	require_grep	FetchContent_Declare\([^)]*GIT_TAG	dependencies must be pinned via FetchContent GIT_TAG
deps_pinned_no_branch	forbid_flag	GIT_TAG\s+["']?(master|main|HEAD|develop)\b	dependencies must pin a release tag or commit SHA, never a branch name

# --- GL ownership & RHI: raw GL calls ONLY under core/rhi/gl/ via IRHIContext (SPEC §3/§6 EOL) -------
# render/, app/, tests/, broker/, scene/, and utils/ must go through core/rhi/ wrappers (IRHIContext); io/, data/, volume/ are GL-free.
# V3 tightens the anchor: raw gl* must be confined to core/rhi/gl/ (one RHI impl); core/ outside that (e.g., core/window.cpp, core/load_core_gl.cpp keep their probes) is now allow-listed as anchor; todo: after V3.2a RHI lands, switch this to `core/rhi/gl|` anchor.
# For incremental migration, the gate keeps `core|` anchor until core/rhi/gl/ exists — `rhi_ownership` is the V3 hard anchor.
gpu_api_ownership	forbid_outside	core|\bgl[A-Z][A-Za-z0-9]*\(	raw GL calls only under core/ (until core/rhi/gl/ lands, then tightens to core/rhi/gl/)
# rhi_ownership	forbid_outside	core/rhi/gl|\bgl[A-Z][A-Za-z0-9]*\(	raw GL calls only under core/rhi/gl/ via IRHIContext (enable when core/rhi/ exists; SOLID DIP + OCP for Vulkan)
# New audit anchor: no raw gl* outside core/ at all (already covered) AND no core/rhi/gl/*.hpp include outside broker/render/core (DIP — scene/io/data/volume may never include RHI)

# --- Legacy fixed-function API must never appear anywhere ----------------------
# glBegin is word-boundary anchored so the legacy immediate-mode entry point
# (glBegin(...)) stays banned while core GL 3.0+ transform feedback
# (glBeginTransformFeedback, used by SliceRenderer's cross-section capture,
# T11) is NOT a legacy call and must not be flagged.
no_legacy_api	forbid_grep	\bglBegin\b|glMatrixMode|glOrtho|glFrustum	legacy fixed-function API is forbidden

# --- Readback discipline: raw readback calls only under core/ ------------------
# (single-GL-owner rule; readback is consumed by tests for verification)
no_production_readback	forbid_outside	core|\b(glMapBufferRange|glGetBufferSubData|glReadPixels|glGetTexImage|glGetTexLevelParameteriv)\b	readback raw calls only under core/ (test-consumed)

# --- Logging discipline: no raw printf/cout for diagnostics --------------------
no_raw_diagnostics	forbid_grep	std::cout|std::cerr|\bprintf\(	logging discipline: use spdlog, not printf/cout

# --- Asset licensing: every dataset dir must carry a LICENSE file --------------
# (grep is a floor; the T2 gate enforces one LICENSE per dataset dir)
assets_licensed	require_grep	LICENSE	at least one LICENSE present (floor); per-dataset-dir LICENSE enforced by T2 gate (SPEC section 7)

# --- Disposition / layer isolation (SPEC §3/§6) ----------------------------------
# scene/ is RE-free + GL-free; render/ never includes scene/; broker/ is the
# only library that may include both scene/ and render/.
# scene/ may include data/ + volume/ + glm only — never render/ or core/ GL.
# NOTE: enforced after V3.1 lands (scene/ + broker/ created); until then the
# concrete forbid is review-only to avoid false positives on docs/examples.
# V3.1 review-gated: both dispositions verified by review (forbid_grep over all SOURCE_DIRS would false-positive on render self-includes/tests); a future forbid_inside mode will make disposition_scene mechanical.
# disposition_scene — review-gated (scene must never include render/ — verified by review, not forbid_grep which would flag render self-includes):	forbid_grep	#include.*render/	re::scene must never include render/ (broker owns the mediation)
# disposition_render — review-gated (per-dir check deferred; forbid_grep over all SOURCE_DIRS would false-positive on scene self-includes and tests):	forbid_grep	#include.*scene/	re::render must never include scene/ (broker owns the mediation)

# --- Broker mediation: one file per mapper + ISP segregation (SPEC §11 SOLID) ----------
# The broker/ mediation is heavily abstracted — one IMapper<AppT,ReT> (pure) or ICachedMapper<AppT,ReT> per file
# (camera_mapper, plane_mapper, *material_mapper, *object_mapper, view_bridge, view_synchronizer, view_compositor).
# IMapper vs ICachedMapper is ISP segregation: a pure mapper must not expose mapCached/invalidate (fat interface).
# A single header that defines translate/mapper for more than one AppT is forbidden. ViewBridge is a SRP-split coordinator
# (ViewSynchronizer + ViewCompositor), not a God mapper.
# This floor rule greps for two distinct "Mapper" class names in one file; the review gate enforces the full one-file-per-type policy.
broker_per_type	forbid_grep	class.*Mapper.*\n.*class.*Mapper	broker/ must be one IMapper/ICachedMapper per file (heavily abstracted per-type mappers, ISP-segregated; ViewBridge is coordinator)
isp_mapper_forbid	forbid_grep	class\s+\w+Mapper\s*:\s*public\s+IMapper[^{]*\{[^}]*mapCached	IMapper must not expose mapCached (ISP — use ICachedMapper)
# srp_viewbridge	forbid_grep	class\s+ViewBridge[^{]*\{[^}]*(sync|renderAll|presentAll)[^}]*sync[^}]*renderAll[^}]*presentAll.*\{	(optional RHI review check — ViewBridge should delegate to ViewSynchronizer/ViewCompositor, not own both caches)

# --- Persistence: never id-only or size-dump sync (SPEC §10) -----------------
# See SPEC §10.1 — CompositeKey{LayoutId,Id,Gen,Hash}, not bare id/size.
# Mechanical floor (recreateAll/dumpAll) is review-only until V3.5 lands.
no_dump_sync	forbid_grep	recreateAll|dumpAll	never use id-only or size-dump recreate-all sync (use generation/contentHash cache)

# --- RE-minimal / asset indirection (SPEC §7/§12) ---------------------------
# render/re_scene must not store verbatim copies of data::Mesh voxels/positions or
# data::VolumeDataset voxels — only derived handles (AssetHandle, Texture3D*, ReMaterial*).
# Review-only until V3.1/V3.6 create render/re_scene/.
# asset_indirection	forbid_grep	data::Mesh.*positions|data::VolumeDataset.*voxels	render/re_scene must not store verbatim app asset data (RE-minimal, use handles)

# --- Broker app-reach rule (SPEC §11) ---------------------------------------
# app/ must not hold a broker mapper handle directly (must go through ViewBridge).
# Review-only until V3.2 ViewBridge lands.
broker_app_reach	forbid_grep	broker.*IMapper|broker.*Mapper.*translate	app must not hold a broker mapper handle directly (use ViewBridge façade)

# --- Build hygiene (generic, reinforce here) -----------------------------------
# (built-in checks already cover warning-suppression flags/pragmas)